@model Villa
@{
    ViewData["Title"] = "Update";
}

<div class="w-100 card border-0 p-4">
    <!-- Card Header -->
    <div class="card-header bg-success bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Update Villa</h2>
            </div>
        </div>
    </div>

    <!-- Card Body -->
    <div class="card-body border p-4">
        <form method="post" asp-action="Update" asp-controller="Villa"  class="row">
            <input asp-for="Id" hidden />
            <div asp-validation-summary="ModelOnly"></div>
            <div class="p-3">
                <!-- Name -->
                <div class="form-floating py-2 col-12">
                    <input asp-for="@Model.Name" class="form-control border shadow" />
                    <label asp-for="@Model.Name" class="ms-2"></label>
                    <span asp-validation-for="@Model.Name" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="form-floating py-2 col-12">
                    <input asp-for="@Model.Description" class="form-control border shadow" />
                    <label asp-for="@Model.Description" class="ms-2"></label>
                     <span asp-validation-for="@Model.Description" class="text-danger"></span>
                </div>

                <!-- Price -->
                <div class="form-floating py-2 col-12">
                    <input asp-for="@Model.Price" class="form-control border shadow" />
                    <label asp-for="@Model.Price" class="ms-2"></label>
                      <span asp-validation-for="@Model.Price" class="text-danger"></span>
                </div>

                <!-- Sqft -->
                <div class="form-floating py-2 col-12">
                    <input asp-for="@Model.Sqft" class="form-control border shadow" />
                    <label asp-for="@Model.Sqft" class="ms-2"></label>
                      <span asp-validation-for="@Model.Sqft" class="text-danger"></span>
                </div>

                <!-- Occupancy -->
                <div class="form-floating py-2 col-12">
                    <input asp-for="@Model.Occupancy" class="form-control border shadow" />
                    <label asp-for="@Model.Occupancy" class="ms-2"></label>
                      <span asp-validation-for="@Model.Occupancy" class="text-danger"></span>
                </div>

                <!-- Image URL -->
                <div class="form-floating py-2 col-12">
                    <input asp-for="@Model.ImageUrl" class="form-control border shadow" />
                    <label asp-for="@Model.ImageUrl" class="ms-2"></label>
                      <span asp-validation-for="@Model.ImageUrl" class="text-danger"></span>
                </div>

                <!-- Submit Button -->
                <div class="row pt-2">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Update
                        </button>
                    </div>

                    <div class="col-6 col-md-3">
                        <a asp-action="index" asp-controller="Villa" class="btn btn-secondary w-100">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {

    @{
                <partial name="_ValidationScriptsPartial" />
    }
}